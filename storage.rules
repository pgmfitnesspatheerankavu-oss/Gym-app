rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() &&
        request.auth.uid == "PDTPALBaQtV8XRJQ8iTu3EhMb5J3";
    }
    function isActiveStaff() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "staff" &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    match /member-photos/{memberId}/{fileName} {
      allow read: if isOwner() || isActiveStaff();
      allow write: if (isOwner() || isActiveStaff()) &&
        request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
