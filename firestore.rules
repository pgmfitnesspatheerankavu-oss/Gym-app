rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The HYFIT build/deployment owner must replace this marker with the
    // first HYFIT Owner account UID. Never use a PGM FITNESS UID here.
    function isOwner() {
      return request.auth != null &&
        request.auth.uid == "HYFIT_OWNER_UID_REPLACE_BEFORE_DEPLOY";
    }
    function signedIn() { return request.auth != null; }
    function isActiveStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function canUseGym() { return isOwner() || isActiveStaff(); }
    function staffHas(permission) {
      return isActiveStaff() &&
        ("permissions" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        permission in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions;
    }
    function expectedPlanFee(plan) {
      return plan == "1 Month" ? 650 :
        plan == "3 Months" ? 1600 :
        plan == "6 Months" ? 2700 :
        plan == "12 Months" ? 4700 :
        plan == "Couple / Duo - 3 Months" ? 3000 : -1;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update, delete: if isOwner();
    }
    function validMemberCreate() {
      return request.resource.data.keys().hasOnly([
        "name", "phone", "address", "gender", "joinDate", "planStartDate",
        "plan", "planFee", "registrationFee", "photoURL", "photoPath", "expiryDate", "status", "notes",
        "createdAt", "createdBy", "updatedAt", "updatedBy",
        "legacySource", "legacyIndex", "migrationVersion",
        "migrationSourceData", "migratedAt", "migratedBy"
      ]) &&
      request.resource.data.keys().hasAll(["name"]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 0 &&
      request.resource.data.name.size() <= 120 &&
      (!("createdBy" in request.resource.data) || request.resource.data.createdBy == request.auth.uid || isOwner()) &&
      (!("updatedBy" in request.resource.data) || request.resource.data.updatedBy == request.auth.uid || isOwner()) &&
      (!("planFee" in request.resource.data) ||
        (request.resource.data.planFee is number &&
         (isOwner() || (isActiveStaff() && request.resource.data.planFee == expectedPlanFee(request.resource.data.plan)))) ) &&
      (!("registrationFee" in request.resource.data) ||
        (request.resource.data.registrationFee is number &&
         request.resource.data.registrationFee >= 0 &&
         request.resource.data.registrationFee <= 100000)) &&
      ((!("migrationVersion" in request.resource.data) &&
        !("migrationSourceData" in request.resource.data) &&
        !("migratedAt" in request.resource.data) &&
        !("migratedBy" in request.resource.data) &&
        !("legacySource" in request.resource.data) &&
        !("legacyIndex" in request.resource.data)) || isOwner());
    }
    match /members/{memberId} {
      allow read: if isOwner() || staffHas("members.read");
      allow create: if (isOwner() || staffHas("members.create")) && validMemberCreate();
      allow update: if isOwner() ||
        (staffHas("members.update") &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "phone", "address", "gender", "joinDate", "planStartDate",
          "plan", "registrationFee", "photoURL", "photoPath", "expiryDate", "status", "notes",
          "updatedAt", "updatedBy"
         ]));
      allow delete: if isOwner() || staffHas("members.delete");
    }
    match /payments/{paymentId} {
      allow read: if isOwner() || staffHas("payments.read.all") ||
        (staffHas("payments.read.own") && resource.data.createdBy == request.auth.uid);
      allow create: if (isOwner() || staffHas("payments.create")) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner();
      allow delete: if isOwner() || staffHas("payments.delete");
    }
    match /renewals/{renewalId} {
      allow read: if isOwner() || staffHas("renewals.read.all") ||
        (staffHas("renewals.read.own") && resource.data.createdBy == request.auth.uid);
      allow create: if (isOwner() || staffHas("renewals.create")) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner();
      allow delete: if isOwner() || staffHas("renewals.delete");
    }
    match /attendance/{attendanceId} {
      allow read: if isOwner() || staffHas("attendance.read");
      allow create: if (isOwner() || staffHas("attendance.create")) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner();
      allow delete: if isOwner() || staffHas("attendance.delete");
    }
    match /expenses/{expenseId} {
      allow read: if isOwner() || staffHas("expenses.read");
      allow create: if isOwner() || staffHas("expenses.create");
      allow update: if isOwner() || staffHas("expenses.update");
      allow delete: if isOwner() || staffHas("expenses.delete");
    }
    match /settings/{document=**} { allow read, write: if isOwner(); }
    match /financialReports/{document=**} { allow read, write: if isOwner(); }
    match /gymData/{document=**} { allow read, write: if isOwner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
